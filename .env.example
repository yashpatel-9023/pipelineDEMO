# ── General ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://username:password@db:5432/dbname

# ── Redis / Cache ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# ── Temporal ─────────────────────────────────────────────────────────────
TEMPORAL_TARGET_HOST=temporal:7233
TEMPORAL_TASK_QUEUE=pipeline-task-queue

# ── Upstream AI Service URLs ─────────────────────────────────────────────
SUMMARY_SERVICE_URL=http://localhost:8001
SUMMARY_SERVICE_API_KEY=

ELIGIBILITY_SERVICE_URL=http://localhost:8002
ELIGIBILITY_SERVICE_API_KEY=

ANNEXURE_SERVICE_URL=http://localhost:8003
ANNEXURE_SERVICE_API_KEY=

TEMPLATE_SERVICE_URL=http://localhost:8004
TEMPLATE_SERVICE_API_KEY=

AUTOFILL_SERVICE_URL=http://localhost:8005
AUTOFILL_SERVICE_API_KEY=

FINAL_RESPONSE_SERVICE_URL=http://localhost:8006
FINAL_RESPONSE_SERVICE_API_KEY=

# ── Eligibility ──────────────────────────────────────────────────────────
ELIGIBILITY_THRESHOLD=100
